{
  "name": "corvon-backend",
  "version": "1.1.0",
  "description": "CORVON legacy recovery API with isolated Recovery v1 API",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.0.0",
    "helmet": "^8.1.0",
    "pg": "^8.22.0",
    "zod": "^3.24.1"
  },
  "scripts": {
    "build": "npm ci && npm --prefix staging-backend ci",
    "start": "node server.js",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "migrate:recovery": "npm --prefix staging-backend run migrate",
    "test": "node --test \"test/*.test.cjs\" \"staging-backend/test/*.test.js\""
  },
  "keywords": [],
